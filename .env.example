# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Secret for NextAuth session encryption.
AUTH_SECRET=

# DEMO_MODE=true serves simulated in-memory data (src/lib/demo-api.ts) instead of the real API.
# Demo associates (NIP 1234, every OTP is 123456):
#   1000001 eligible · 1000002 late payment · 1000003 under 3 months
#   1000004 personal loan service down · 1000005 malformed personal loan response
# Financed phone (Samsung Galaxy A17); add ?demoDevice=1 to a page to simulate the phone mini-app:
#   1000006 eligible, no request · 1000007 SOLICITADO · 1000008 ENGANCHE_CONFIRMADO
#   1000009 EN_PREPARACION · 1000010 LISTO_PARA_RECOGER · 1000017 CANCELADO
#   1000011 phone ACTIVE (vales only from the phone) · 1000012 phone REPORTED (vales blocked)
#   1000013 phone ACTIVE, late notice (AVISO) · 1000014 phone ACTIVE, grace period (GRACIA)
#   1000015 not eligible for the phone · 1000016 phone service down (fail-closed)
DEMO_MODE=true

# Base URL of the PrestaGana+ REST API (must end with a slash). Ignored when DEMO_MODE=true.
# In production, a missing API_BASE_URL without DEMO_MODE=true is an error (no silent fallback to demo data).
API_BASE_URL=
