# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Secret for NextAuth session encryption. Generate one with: npx auth secret
AUTH_SECRET=

# The app uses simulated in-memory data unless USE_REAL_API=true.
# Demo login: associate 1000001, NIP 1234; every OTP is 123456.
USE_REAL_API=false

# Base URL of the PrestaGana+ REST API (must end with a slash). Only used when USE_REAL_API=true.
API_BASE_URL=
