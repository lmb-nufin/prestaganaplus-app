# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Secret for NextAuth session encryption.
AUTH_SECRET=

# DEMO_MODE=true serves simulated in-memory data (src/lib/demo-api.ts) instead of the real API.
# Demo associates (NIP 1234, every OTP is 123456):
#   1000001 eligible · 1000002 late payment · 1000003 under 3 months · 1000004 personal loan service down
DEMO_MODE=true

# Base URL of the PrestaGana+ REST API (must end with a slash). Ignored when DEMO_MODE=true.
API_BASE_URL=
